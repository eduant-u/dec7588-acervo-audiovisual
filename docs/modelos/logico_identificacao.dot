digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.7", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#65796d", arrowsize=0.7];
"fonte_dados" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>fonte_dados</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR><TR><TD ALIGN="LEFT">url : text</TD></TR><TR><TD ALIGN="LEFT">descricao : text</TD></TR></TABLE>>];
"lote_importacao" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>lote_importacao</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">fonte_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR><TR><TD ALIGN="LEFT">sha256 : varchar</TD></TR><TR><TD ALIGN="LEFT">data_importacao : timestamptz</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"tipo_obra" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>tipo_obra</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR><TR><TD ALIGN="LEFT">descricao : text</TD></TR></TABLE>>];
"obra" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>obra</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">chave_tcc : text</TD></TR><TR><TD ALIGN="LEFT">titulo_referencia : text</TD></TR><TR><TD ALIGN="LEFT">nivel : varchar</TD></TR><TR><TD ALIGN="LEFT">status : varchar</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"registro_fonte" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>registro_fonte</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">obra_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">lote_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">tipo_obra_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">chave_origem : text</TD></TR><TR><TD ALIGN="LEFT">identificador_fonte : text</TD></TR><TR><TD ALIGN="LEFT">ano : integer</TD></TR><TR><TD ALIGN="LEFT">duracao_minutos : numeric</TD></TR><TR><TD ALIGN="LEFT">original_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">perfil_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">proveniencia_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"titulo" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>titulo</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">valor : text</TD></TR><TR><TD ALIGN="LEFT">tipo : varchar</TD></TR></TABLE>>];
"certificado" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>certificado</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">numero : varchar</TD></TR><TR><TD ALIGN="LEFT">esquema : varchar</TD></TR><TR><TD ALIGN="LEFT">papel : varchar</TD></TR><TR><TD ALIGN="LEFT">data_emissao : date</TD></TR><TR><TD ALIGN="LEFT">situacao : text</TD></TR></TABLE>>];
"caracteristica_tecnica" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>caracteristica_tecnica</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR><TR><TD ALIGN="LEFT">valor : text</TD></TR><TR><TD ALIGN="LEFT">unidade : varchar</TD></TR></TABLE>>];
"fonte_dados" -> "lote_importacao" [label="fonte\n1 : 0..N",dir=none];
"obra" -> "registro_fonte" [label="obra\n1 : 0..N",dir=none];
"lote_importacao" -> "registro_fonte" [label="lote\n1 : 0..N",dir=none];
"tipo_obra" -> "registro_fonte" [label="tipo_obra\n0..1 : 0..N",dir=none];
"registro_fonte" -> "titulo" [label="registro\n1 : 0..N",dir=none];
"registro_fonte" -> "certificado" [label="registro\n1 : 0..N",dir=none];
"registro_fonte" -> "caracteristica_tecnica" [label="registro\n1 : 0..N",dir=none];
}