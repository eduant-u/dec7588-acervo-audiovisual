digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.7", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#65796d", arrowsize=0.7];
"fonte_dados" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>fonte_dados</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR><TR><TD ALIGN="LEFT">url : text</TD></TR><TR><TD ALIGN="LEFT">descricao : text</TD></TR></TABLE>>];
"registro_fonte" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>registro_fonte</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">obra_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">lote_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">tipo_obra_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">chave_origem : text</TD></TR><TR><TD ALIGN="LEFT">identificador_fonte : text</TD></TR><TR><TD ALIGN="LEFT">ano : integer</TD></TR><TR><TD ALIGN="LEFT">duracao_minutos : numeric</TD></TR><TR><TD ALIGN="LEFT">original_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">perfil_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">proveniencia_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"pessoa" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>pessoa</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">fonte_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">nome : text</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"empresa" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>empresa</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">fonte_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">nome : text</TD></TR><TR><TD ALIGN="LEFT">cnpj : varchar</TD></TR><TR><TD ALIGN="LEFT">uf : varchar</TD></TR><TR><TD ALIGN="LEFT">municipio : text</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"funcao_credito" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>funcao_credito</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR><TR><TD ALIGN="LEFT">descricao : text</TD></TR></TABLE>>];
"credito_pessoa" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>credito_pessoa</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">pessoa_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">funcao_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">personagem : text</TD></TR><TR><TD ALIGN="LEFT">evidencia : text</TD></TR></TABLE>>];
"participacao_empresa" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>participacao_empresa</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">empresa_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">papel : varchar</TD></TR><TR><TD ALIGN="LEFT">evidencia : text</TD></TR></TABLE>>];
"fonte_dados" -> "pessoa" [label="fonte\n1 : 0..N",dir=none];
"fonte_dados" -> "empresa" [label="fonte\n1 : 0..N",dir=none];
"registro_fonte" -> "credito_pessoa" [label="registro\n1 : 0..N",dir=none];
"pessoa" -> "credito_pessoa" [label="pessoa\n1 : 0..N",dir=none];
"funcao_credito" -> "credito_pessoa" [label="funcao\n1 : 0..N",dir=none];
"registro_fonte" -> "participacao_empresa" [label="registro\n1 : 0..N",dir=none];
"empresa" -> "participacao_empresa" [label="empresa\n1 : 0..N",dir=none];
}