digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.7", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#65796d", arrowsize=0.7];
"fonte_dados" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Fontes de dados\nnome, endereço, descrição",fontname="Arial",fontsize=15];
"lote_importacao" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Lotes de importação\nnome, hash, data de importação",fontname="Arial",fontsize=15];
"tipo_obra" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Tipos de obra\nnome, descrição",fontname="Arial",fontsize=15];
"obra" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Obras audiovisuais\ntítulo de referência, nível, status",fontname="Arial",fontsize=15];
"registro_fonte" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Registros das fontes\nidentificador, ano, duração, proveniência",fontname="Arial",fontsize=15];
"titulo" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Títulos\nvalor, tipo",fontname="Arial",fontsize=15];
"certificado" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Certificados\nnúmero, esquema, papel, emissão",fontname="Arial",fontsize=15];
"pessoa" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Pessoas\nnome declarado, observação",fontname="Arial",fontsize=15];
"empresa" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Empresas\nnome, CNPJ, UF, município",fontname="Arial",fontsize=15];
"funcao_credito" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Funções de crédito\nnome, descrição",fontname="Arial",fontsize=15];
"credito_pessoa" [shape=diamond,style="rounded,filled",fillcolor="#edf3ee",label="Créditos de pessoas\npersonagem, evidência",fontname="Arial",fontsize=15];
"participacao_empresa" [shape=diamond,style="rounded,filled",fillcolor="#edf3ee",label="Participações de empresas\npapel, evidência",fontname="Arial",fontsize=15];
"pais" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Países\nnome declarado",fontname="Arial",fontsize=15];
"obra_pais" [shape=diamond,style="rounded,filled",fillcolor="#edf3ee",label="Países de produção\nevidência",fontname="Arial",fontsize=15];
"genero" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Gêneros\nnome declarado",fontname="Arial",fontsize=15];
"obra_genero" [shape=diamond,style="rounded,filled",fillcolor="#edf3ee",label="Gêneros por registro\nassociação por registro",fontname="Arial",fontsize=15];
"caracteristica_tecnica" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Características técnicas\nnome, valor, unidade",fontname="Arial",fontsize=15];
"relacao_obra" [shape=diamond,style="rounded,filled",fillcolor="#edf3ee",label="Relações entre obras\ntipo, status, evidência",fontname="Arial",fontsize=15];
"decisao_integracao" [shape=box,style="rounded,filled",fillcolor="#edf3ee",label="Decisões de integração\nparecer, justificativa, responsável, data",fontname="Arial",fontsize=15];
"fonte_dados" -> "lote_importacao" [label="fonte\n1 : 0..N",dir=none];
"obra" -> "registro_fonte" [label="obra\n1 : 0..N",dir=none];
"lote_importacao" -> "registro_fonte" [label="lote\n1 : 0..N",dir=none];
"tipo_obra" -> "registro_fonte" [label="tipo_obra\n0..1 : 0..N",dir=none];
"registro_fonte" -> "titulo" [label="registro\n1 : 0..N",dir=none];
"registro_fonte" -> "certificado" [label="registro\n1 : 0..N",dir=none];
"fonte_dados" -> "pessoa" [label="fonte\n1 : 0..N",dir=none];
"fonte_dados" -> "empresa" [label="fonte\n1 : 0..N",dir=none];
"registro_fonte" -> "credito_pessoa" [label="registro\n1 : 0..N",dir=none];
"pessoa" -> "credito_pessoa" [label="pessoa\n1 : 0..N",dir=none];
"funcao_credito" -> "credito_pessoa" [label="funcao\n1 : 0..N",dir=none];
"registro_fonte" -> "participacao_empresa" [label="registro\n1 : 0..N",dir=none];
"empresa" -> "participacao_empresa" [label="empresa\n1 : 0..N",dir=none];
"registro_fonte" -> "obra_pais" [label="registro\n1 : 0..N",dir=none];
"pais" -> "obra_pais" [label="pais\n1 : 0..N",dir=none];
"registro_fonte" -> "obra_genero" [label="registro\n1 : 0..N",dir=none];
"genero" -> "obra_genero" [label="genero\n1 : 0..N",dir=none];
"registro_fonte" -> "caracteristica_tecnica" [label="registro\n1 : 0..N",dir=none];
"obra" -> "relacao_obra" [label="origem\n1 : 0..N",dir=none];
"obra" -> "relacao_obra" [label="destino\n1 : 0..N",dir=none];
"registro_fonte" -> "decisao_integracao" [label="registro_a\n1 : 0..N",dir=none];
"registro_fonte" -> "decisao_integracao" [label="registro_b\n1 : 0..N",dir=none];
}