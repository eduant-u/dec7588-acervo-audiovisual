digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.7", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#65796d", arrowsize=0.7];
"obra" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>obra</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">chave_tcc : text</TD></TR><TR><TD ALIGN="LEFT">titulo_referencia : text</TD></TR><TR><TD ALIGN="LEFT">nivel : varchar</TD></TR><TR><TD ALIGN="LEFT">status : varchar</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"registro_fonte" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>registro_fonte</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">obra_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">lote_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">tipo_obra_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">chave_origem : text</TD></TR><TR><TD ALIGN="LEFT">identificador_fonte : text</TD></TR><TR><TD ALIGN="LEFT">ano : integer</TD></TR><TR><TD ALIGN="LEFT">duracao_minutos : numeric</TD></TR><TR><TD ALIGN="LEFT">original_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">perfil_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">proveniencia_json : jsonb</TD></TR><TR><TD ALIGN="LEFT">observacao : text</TD></TR></TABLE>>];
"pais" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>pais</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR></TABLE>>];
"obra_pais" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>obra_pais</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">pais_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">evidencia : text</TD></TR></TABLE>>];
"genero" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>genero</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">nome : varchar</TD></TR></TABLE>>];
"obra_genero" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>obra_genero</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">genero_id : bigint [FK]</TD></TR></TABLE>>];
"relacao_obra" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>relacao_obra</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">origem_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">destino_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">tipo : varchar</TD></TR><TR><TD ALIGN="LEFT">status : varchar</TD></TR><TR><TD ALIGN="LEFT">evidencia_json : jsonb</TD></TR></TABLE>>];
"decisao_integracao" [label=<<TABLE BORDER="1" COLOR="#bccbbf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#185f52" ALIGN="LEFT"><FONT COLOR="white"><B>decisao_integracao</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">registro_a_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">registro_b_id : bigint [FK]</TD></TR><TR><TD ALIGN="LEFT">parecer : varchar</TD></TR><TR><TD ALIGN="LEFT">justificativa : text</TD></TR><TR><TD ALIGN="LEFT">responsavel : varchar</TD></TR><TR><TD ALIGN="LEFT">data_decisao : timestamptz</TD></TR></TABLE>>];
"obra" -> "registro_fonte" [label="obra\n1 : 0..N",dir=none];
"registro_fonte" -> "obra_pais" [label="registro\n1 : 0..N",dir=none];
"pais" -> "obra_pais" [label="pais\n1 : 0..N",dir=none];
"registro_fonte" -> "obra_genero" [label="registro\n1 : 0..N",dir=none];
"genero" -> "obra_genero" [label="genero\n1 : 0..N",dir=none];
"obra" -> "relacao_obra" [label="origem\n1 : 0..N",dir=none];
"obra" -> "relacao_obra" [label="destino\n1 : 0..N",dir=none];
"registro_fonte" -> "decisao_integracao" [label="registro_a\n1 : 0..N",dir=none];
"registro_fonte" -> "decisao_integracao" [label="registro_b\n1 : 0..N",dir=none];
}