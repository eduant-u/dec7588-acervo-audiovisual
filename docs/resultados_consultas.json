  {
    "titulo": "Obras com CPB por fonte e papel",
    "objetivo": "Contar obras com CPB, preservando a distinção entre certificado próprio, da série e do episódio.",
    "unidade": "obras distintas por fonte e papel do CPB",
    "nota": "Uma obra pode participar de mais de uma categoria. As contagens não devem ser somadas como total único.",
    "sql": "SELECT f.nome AS fonte,c.papel,COUNT(DISTINCT r.obra_id) AS total_obras\nFROM audiovisual.certificado c\nJOIN audiovisual.registro_fonte r ON r.id=c.registro_id\nJOIN audiovisual.lote_importacao l ON l.id=r.lote_id\nJOIN audiovisual.fonte_dados f ON f.id=l.fonte_id\nWHERE c.esquema='CPB'\nGROUP BY f.nome,c.papel\nORDER BY fonte,papel;",
